# API
DATABASE_URL=postgres://postgres:postgres@localhost:5432/consentflow
JWT_SECRET=change-me
# Public URL of the API; embedded in cmp.js so the banner knows where to send consents
PUBLIC_API_URL=http://localhost:4000
# Used to build invitation links
DASHBOARD_URL=http://localhost:5173
# Allow ?cf_country=DE&cf_region=CA on cmp.js to override geo-IP (development/QA only)
ALLOW_GEO_OVERRIDE=true
# Country to assume when no CDN geo header is present (empty = unknown, uses the "*" rule)
DEFAULT_COUNTRY=
# Reject consent posts from origins that are not the domain's hostnames
STRICT_ORIGIN=true
# Set to false to skip running migrations and seeding the cookie library at API start
AUTO_MIGRATE=true

# Scanner
SCANNER_POLL_MS=5000
# Optional: path to a Chromium binary if Playwright's bundled browser is not installed
CHROMIUM_PATH=

# Dashboard (build time)
VITE_API_URL=http://localhost:4000
